# Salin file ini sebagai .env jika ingin memakai konfigurasi environment.
# Jangan masukkan API key, token, atau password ke repository.

WHISPER_MODEL=small
OLLAMA_MODEL=llama3.2:3b

# Opsional. Bisa juga memilih model langsung dari aplikasi PyQt6.
QWEN_GGUF_PATH=
HERMES_GGUF_PATH=

# -1 = gunakan GPU yang tersedia, 0 = CPU saja.
GGUF_N_GPU_LAYERS=-1
GGUF_N_CTX=8192
GEMINI_API_KEY=AIzaSyYourGeminiKeyHere
